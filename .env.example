# ── scrible local configuration ─────────────────────────────────────────────
#
# Copy this file to `.env` and paste your values in. `.env` is gitignored and
# must never be committed.
#
#   cp .env.example .env
#
# This file is for LOCAL DEVELOPMENT only. On Fly these come from
# `fly secrets set ...`, which is what the deployed app reads instead.

# ── Voice (LiveKit) ─────────────────────────────────────────────────────────
# Get these from https://cloud.livekit.io → your project → Settings → Keys.
# Leave them blank and the game still runs perfectly — it just says
# "Text only" instead of offering voice.

# The WebSocket URL of your LiveKit project, e.g. wss://my-app.livekit.cloud
LIVEKIT_URL=

# Starts with "API"
LIVEKIT_API_KEY=

# The secret shown once when you create the key. Server-side only — it signs
# access tokens and is never sent to a browser.
LIVEKIT_API_SECRET=

# ── Sessions ────────────────────────────────────────────────────────────────
# Signs the tokens that let a disconnected player reclaim their seat and score.
# Optional locally: if blank, the server generates a random one at startup,
# which is correct behaviour — the in-memory rooms those tokens point at do not
# survive a restart either.
#
# Generate one with:  openssl rand -hex 32
REJOIN_SECRET=

# ── Server ──────────────────────────────────────────────────────────────────
PORT=3000
